# Send only what the Dockerfile needs to the build context
*

# Include API source
!api/package*.json
!api/local-server.js
!api/utils.js
!api/config.js
!api/openapi.yaml
!api/parameters.yaml
!api/schemas/
!api/responses/
!api/scripts/
!api/query-builder.js
!api/cache.js

# Include shared root files
!paths.js
!config.yaml

# Include data (downloaded from S3 in CI)
# Exclude scenarios/ (~15GB) - not used by the API server
!data/
data/scenarios/
