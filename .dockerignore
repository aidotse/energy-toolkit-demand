# Send only what the Dockerfile needs to the build context
*

# Include API source. Globs — not an explicit file list — so new source files
# are picked up automatically. We got bitten by this when cache.js and csv.js
# were added and silently missing from the image.
!api/package*.json
!api/*.js
!api/openapi.yaml
!api/parameters.yaml
!api/schemas/
!api/responses/
!api/scripts/

# Include shared root files
!paths.js
!config.yaml

# Include entrypoint script
!infrastructure/entrypoint.sh
