{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "login": "aws sso login --profile AWSAdministratorAccess-600627346413",
    "generate-api": "node generate-api.js",
    "build:static-endpoints": "node scripts/generate-endpoints.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node local-server.js",
    "docs:build": "typedoc",
    "docs:serve": "npx http-server docs/api -p 8081 -o",
    "docs:watch": "typedoc --watch",
    "docs:openapi": "node scripts/generate-openapi-docs.js",
    "docs:serve-openapi": "npm run docs:openapi && npx http-server docs/openapi -p 8082 -o",
    "docs:build-all": "npm run docs:build && npm run docs:openapi",
    "docs:serve-all": "npm run docs:build-all && echo 'API Docs: http://localhost:8081' && echo 'OpenAPI Docs: http://localhost:8082' && npx http-server docs -p 8080 -o"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@inquirer/prompts": "^7.8.6",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "duckdb": "^1.2.1",
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "json-schema-ref-parser": "^9.0.9",
    "openapi-backend": "^5.12.0",
    "qs": "^6.14.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.5.2",
    "@types/qs": "^6.14.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "http-server": "^14.1.1",
    "supertest": "^7.1.4",
    "swagger-ui-dist": "^5.29.0",
    "typedoc": "^0.28.13",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
