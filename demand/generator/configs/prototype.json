{
    "config-name": "prototype",
    "access": "public",
    "start-year": 2025,
    "end-year": 2045,
    "resolution": "1h",
    "geographies": "geographies/georef-sweden-kommun@public.geojson",
    "loader": {
        "name": "base_load_curve",
        "properties": {
            "access": "public",
            "base-year": 2025,
            "geo-type": "national",
            "normalized": false
        }
    },
    "transformers": [
        {
            "name": "municipality_energy_split",
            "order": 1,
            "access": "public",
            "inputs": [
                {
                    "name": "municipality_energy_split",
                    "path": "municipality_energy_split/municipality_energy_split.csv",
                    "index": "municipality",
                    "columns": ["municipality", "ratio"]
                }
            ]
        },
        {
            "name": "growth_over_time",
            "order": 2,
            "access": "public",
            "inputs": []
        }
    ],
    "output": {
        "properties": {
            "aggregation": [
                {"resolution": "1h", "statistics": ["none"]},
                {"resolution": "3h", "statistics": ["mean", "sum", "min", "max"]},
                {"resolution": "1d", "statistics": ["mean", "sum", "min", "max"]},
                {"resolution": "1W", "statistics": ["mean", "sum", "min", "max"]},
                {"resolution": "1ME", "statistics": ["mean", "sum", "min", "max"]},
                {"resolution": "1YE", "statistics": ["sum"]}

            ],
            "sectors": [
                "total",
                "buildings",
                "industry",
                "transport"
            ],
            "geography": ""

        }
    }

}