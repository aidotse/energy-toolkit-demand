{
    "config-name": "county-prototype",
    "access": "public",
    "start-time": "2025-01-01 00:00:00",
    "end-time": "2045-12-31 23:00:00",
    "resolution": "1h",
    "geography": {
        "type": "county",
        "source": "sweden-counties.geojson"
    },
    "scenarios": [
        {
            "name": "growth",
            "type": "scalar",
            "values": [1, 2, 3],
            "default": 2,
            "labels": ["low", "mid", "high"],
            "description": ""
        },
        {
            "name": "housing-flex",
            "type": "scalar",
            "values": [0, 0.5, 1],
            "default": 0.5,
            "labels": ["low", "mid", "high"],
            "description": ""
        },
        {
            "name": "industry-flex",
            "type": "scalar",
            "values": [0, 0.5, 1],
            "default": 0.5,
            "labels": ["low", "mid", "high"],
            "description": ""
        },
        {
            "name": "transport-flex",
            "type": "scalar",
            "values": [0, 0.5, 1],
            "default": 0.5,
            "labels": ["low", "mid", "high"],
            "description": ""
        },
        {
            "name": "transport-electrification",
            "type": "scalar",
            "values": [0, 0.5, 1],
            "default": 0.5,
            "labels": ["low", "mid", "high"],
            "description": ""
        },
        {
            "name": "industry-transition",
            "type": "scalar",
            "values": [0, 0.5, 1],
            "default": 0.5,
            "labels": ["low", "mid", "high"],
            "description": ""
        },
        {
            "name": "low_transport_electrification_low_housing_flex",
            "type": "constraint",
            "components": ["housing-flex", "transport-electrification"],
            "description": ""
        },
        {
            "name": "low_growth_low_industry_transition",
            "type": "constraint",
            "components": ["growth", "industry-transition"],
            "description": ""
        }

    ],
    "loader": {
        "name": "base_load_curve",
        "properties": {
            "access": "public",
            "base-year": 2025,
            "geo-type": "national",
            "normalized": false,
            "resolution": "1h",
            "aggregation": "mean"
        }
    },
    "transformers": [
        {
            "name": "county_energy_split",
            "order": 1,
            "access": "public",
            "type": "factor-split",
            "randomness": true,
            "inputs": [
                {
                    "name": "county_energy_split",
                    "path": "county_energy_split/county_energy_split.csv",
                    "columns": ["geography", "factor"],
                    "index": "geography"
                }
            ]
        },
        {
            "name": "growth_over_time",
            "order": 2,
            "access": "public",
            "type": "dynamic",
            "scenarios": [
                {"index": 1, "label": "low", "name": "growth", "type": "exp-growth-to-target", "target": 2, "random": true, "randomness": 0.1},
                {"index": 2, "label": "mid", "name": "growth", "type": "exp-growth-to-target", "target": 2.33, "random": true, "randomness": 0.1},
                {"index": 3, "label": "high", "name": "growth", "type": "exp-growth-to-target", "target": 2.4, "random": true, "randomness": 0.1}
            ]
        },
        {
            "name": "sector_split",
            "order": 3,
            "access": "public",
            "inputs": []
}        
    ],
    "output": {
        "properties": {
            "aggregations": [
                {"resolution": "1h", "aggregation": ["none"]},
                {"resolution": "1d", "aggregation": ["mean", "sum", "max"]},
                {"resolution": "1ME", "aggregation": ["mean", "sum", "max"]},
                {"resolution": "1YE", "aggregation": ["mean", "sum", "max"]}

            ],
            "sectors": [
                "total",
                "buildings",
                "industry",
                "transport"
            ],
            "geography": ""

        }
    }

}