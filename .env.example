# Copy this file to explorer/.env and fill in values for local development.

# Mapbox access token — required for the map widget to render.
# Get one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# (Optional) Override the default Mapbox style.
# Defaults to mapbox://styles/mapbox/light-v11 when unset.
# VITE_MAPBOX_STYLE_LIGHT=
